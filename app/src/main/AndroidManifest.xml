<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Map tiles for the track editor (FBBD-56). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Asked for on the first-run checklist (UI-13). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The recorder runs as a foreground service and keeps the CPU awake while recording (FBBD-69). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- And as a connected device, for the receiver and sensors over Bluetooth or Wi-Fi (FBBD-34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Phone video runs as its own foreground service (FBBD-21). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Video with data is rendered while the app may be in the background (FBBD-152). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- Open GoPro download after a session: join the camera's own Wi-Fi (FBBD-22). -->
    <!-- A Wi-Fi GPS receiver's socket is kept on Wi-Fi (FBBD-115). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- In-app updates from GitHub Releases open Android's installer; the user confirms each one (FBBD-73). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Video and audio are optional (GoPro or no camera), so this hardware must not be required to install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Spoken coach cues use the phone's text-to-speech engine (FBBD-98). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- largeHeap: an hour of recorded data is read whole for analysis and export; the default
         256 MB on a Pixel 6 ran a 63-minute session's export out of memory (FBBD-232). -->
    <application
        android:name=".BetterDriverApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetterDriver">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Session bundles and track files from the other device, opened from Quick Share or a file
                 manager (FBBD-23, FBBD-80). They have no registered type, so they arrive as generic files;
                 the app checks the content and refuses anything else. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Own process: a crash in the UI, coach or analysis never stops a recording (FBBD-69).
             Each type is claimed only while its permission is granted (recorderForegroundTypes, FBBD-34). -->
        <service
            android:name=".recording.RecorderService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice"
            android:process=":recorder" />

        <!-- Own process too: a camera crash or hang never reaches the recorder (FBBD-21, FBBD-69). -->
        <service
            android:name=".camera.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone"
            android:process=":camera" />

        <!-- The live coach, own process too: the recorder binds to it for each recording, and a coach
             crash or hang never reaches the recording (FBBD-98, FBBD-69). -->
        <service
            android:name=".coach.CoachService"
            android:exported="false"
            android:process=":coach" />

        <!-- Keeps the app alive while a video with data renders (FBBD-152). In the UI process, where the
             export runs; never in the recorder's. Media processing on Android 15+, data sync before. -->
        <service
            android:name=".videoexport.VideoExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Hands a downloaded, checked update to Android's installer (FBBD-73). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Hands prepared session bundles and track files to the share sheet (FBBD-23, FBBD-80). -->
        <provider
            android:name=".sharing.TransferFileProvider"
            android:authorities="${applicationId}.transfer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/transfer_paths" />
        </provider>
    </application>

</manifest>
