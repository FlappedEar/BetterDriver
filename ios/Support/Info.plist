<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys Xcode cannot generate from INFOPLIST_KEY_ settings; the generated ones are merged in (project.yml). -->
<plist version="1.0">
<dict>
	<!-- A recording keeps reading the RaceBox and the phone's GPS with the phone locked (FBBD-332). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
		<!-- The coach keeps saying its cues with the phone locked (FBBD-333). -->
		<string>audio</string>
	</array>
	<!-- A Wi-Fi OBD-II adapter on its own network, at 192.168.0.10 (FBBD-333): iOS asks once. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>BetterDriver reads a Wi-Fi OBD-II adapter on its own Wi-Fi network while it records.</string>
	<!-- Sessions open from Files, AirDrop and other apps' Share sheet (FBBD-331, UI-292 A). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BetterDriver session</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.flappedear.betterdriver.session</string>
			</array>
		</dict>
		<!-- Sessions from other apps become sessions here, as on Android (FBBD-164). -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>VBO file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.racelogic.vbo</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>RaceChrono CSV</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<!-- Racelogic's VBO, declared by its maker, not by this app. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.racelogic.vbo</string>
			<key>UTTypeDescription</key>
			<string>VBO file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vbo</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.flappedear.betterdriver.session</string>
			<key>UTTypeDescription</key>
			<string>BetterDriver session</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bdsession</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- The app copies a session in; it does not edit files where they are. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
