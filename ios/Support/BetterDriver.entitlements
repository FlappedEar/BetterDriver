<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements (project.yml CODE_SIGN_ENTITLEMENTS). Hotspot Configuration joins a GoPro's
     own Wi-Fi to download its video after the drive (FBBD-343); ios-release.yml turns the capability on
     for the App ID before it signs. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
</dict>
</plist>
